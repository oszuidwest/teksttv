---
import Layout from '../../../layouts/Layout.astro'
import { DevOverlay } from '../../../components/DevOverlay'
import { Frame } from '../../../components/zuidwest/Frame'
import { Ticker } from '../../../components/zuidwest/Ticker'
import { WeatherSlide } from '../../../components/zuidwest/WeatherSlide'
import { sampleWeatherSlide } from '../../../devFixtures'
---

<Layout title="Dev - ZuidWest Weather">
  <div class="relative h-[1080px] w-[1920px]">
    <Frame client:only="react" theme="green">
      <WeatherSlide client:only="react" theme="green" content={sampleWeatherSlide}>
        <Ticker
          client:only="react"
          theme="green"
          items={[{ message: 'Morgen op TV: Talkshow M²' }]}
          currentIndex={0}
        />
      </WeatherSlide>
    </Frame>
    <DevOverlay client:only="react" src="/dev/weather-green.png" />
  </div>
</Layout>
