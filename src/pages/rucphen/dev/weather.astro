---
import Layout from '../../../layouts/Layout.astro'
import { Ticker } from '../../../components/rucphen/Ticker'
import { WeatherSlide } from '../../../components/rucphen/WeatherSlide'
import { sampleWeatherSlide } from '../../../devFixtures'
---

<Layout title="Dev - Rucphen Weather">
  <div class="relative h-[1080px] w-[1920px]">
    <WeatherSlide client:only="react" content={sampleWeatherSlide}>
      <Ticker
        client:only="react"
        items={[{ message: 'Nu op Radio Rucphen: Non-Stop' }]}
        currentIndex={0}
      />
    </WeatherSlide>
  </div>
</Layout>
